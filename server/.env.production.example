NODE_ENV=production
PORT=5000

# Database: prefer DATABASE_URL from your managed Postgres provider.
DATABASE_URL=postgresql://username:password@host:5432/database?sslmode=require
PGSSL=true
PGSSLMODE=require
PGSSL_REJECT_UNAUTHORIZED=true
PG_CONNECT_TIMEOUT_MS=15000
PG_IDLE_TIMEOUT_MS=30000
PG_POOL_MAX=10

# Frontend / public URLs
CORS_ORIGIN=https://yourdomain.com
PUBLIC_API_BASE_URL=https://api.yourdomain.com
PUBLIC_SITE_URL=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com
DASHBOARD_URL=https://yourdomain.com/login
PASSWORD_RESET_URL_BASE=https://yourdomain.com/reset-password
LEARNER_SIGNIN_URL=https://yourdomain.com/login
FRONTEND_DIST_DIR=../frontend/dist

# Auth
JWT_SECRET=replace_with_a_48_plus_character_random_secret
JWT_EXPIRES_IN=8h
AUTH_FORGOT_ALLOW_ANY_EMAIL=false
AUTH_DEBUG_RETURN_RESET_TOKEN=false

# Email
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@yourdomain.com
SMTP_PASS=replace_with_real_smtp_password
DIGITAL_HUB_EMAIL=no-reply@yourdomain.com
MAIL_FROM_NAME=Digital Hub
MAIL_FROM_ADDRESS=no-reply@yourdomain.com
ADMIN_NOTIFY_EMAIL=admin@yourdomain.com

# WhatsApp (optional: leave blank if unused)
WHATSAPP_PROVIDER=meta
META_WA_API_VERSION=v19.0
META_WA_TOKEN=
META_PHONE_NUMBER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Redis (optional — used for caching/rate-limit)
REDIS_URL=redis://localhost:6379

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info

# Misc optional
JSON_BODY_LIMIT=8mb
LOG_ROUTES=false
