NODE_ENV=development
PORT=5000

# Database
PGHOST=your-postgres-host
PGPORT=5432
PGDATABASE=digital_hub
PGUSER=postgres
PGPASSWORD=replace_with_database_password
PGSSL=true
PGSSLMODE=require
PGSSL_REJECT_UNAUTHORIZED=true
PG_CONNECT_TIMEOUT_MS=10000
PG_IDLE_TIMEOUT_MS=30000
PG_POOL_MAX=10

# API / frontend integration
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
PUBLIC_API_BASE_URL=http://localhost:5000
PUBLIC_SITE_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
DASHBOARD_URL=http://localhost:5173/login
PASSWORD_RESET_URL_BASE=http://localhost:5173/reset-password
LEARNER_SIGNIN_URL=http://localhost:5173/login
FRONTEND_DIST_DIR=../frontend/dist

# Auth
JWT_SECRET=replace_with_a_48_plus_character_secret
JWT_EXPIRES_IN=8h
AUTH_FORGOT_ALLOW_ANY_EMAIL=false
AUTH_DEBUG_RETURN_RESET_TOKEN=false

# Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@yourdomain.com
SMTP_PASS=replace_with_smtp_password
DIGITAL_HUB_EMAIL=no-reply@yourdomain.com
MAIL_FROM_NAME=Digital Hub
MAIL_FROM_ADDRESS=no-reply@yourdomain.com
ADMIN_NOTIFY_EMAIL=admin@yourdomain.com

# WhatsApp (optional)
WHATSAPP_PROVIDER=meta
META_WA_API_VERSION=v19.0
META_WA_TOKEN=
META_PHONE_NUMBER_ID=
# WhatsApp: ensure the recipient's phone is in E.164 format (+1234567890)
# For Meta Cloud API test mode, only pre-approved test numbers will receive messages.
# Add META_WA_TEST_NUMBERS=1234567890,0987654321 (comma-separated, digits only) to warn on non-test sends.
META_WA_TEST_NUMBERS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Misc optional
REDIS_URL=redis://localhost:6379
JSON_BODY_LIMIT=8mb
LOG_ROUTES=false
